# Provider: openai or google
LLM_PROVIDER=openai

# OpenAI API key (required for LLM_PROVIDER=openai)
OPENAI_API_KEY=openai_api_key

# Google GenAI API key (required for LLM_PROVIDER=google)
GOOGLE_API_KEY=google_api_key

# Model name to be used (specified according to the provider)
# Examples of OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Google example: gemini-1.5-flash, gemini-1.5-pro
LLM_MODEL=gpt-4o-mini
